# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# DEMO_MODE: When true, provides realistic simulated satellite, weather, market, SMS and OTP data
DEMO_MODE="true"

# TWILIO: Optional SMS provider
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# OPENWEATHER_API_KEY: Optional real weather provider
OPENWEATHER_API_KEY=""

# SENTINEL_HUB_CLIENT_ID: Optional real satellite provider
SENTINEL_HUB_CLIENT_ID=""
SENTINEL_HUB_CLIENT_SECRET=""

# PORT: Server port (defaults to 3000)
PORT=3000
